#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};

/ {
    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
            label = "sensor_rotate_msc";
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            label = "sensor_rotate_kp";
        };

        mod_morph_lp_rp: mod_morph_lp_rp_ {
            compatible = "zmk,behavior-mod-morph";
            label = "mod_morph_lp_rp";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_morph_q_esc: mod_morph_q_esc_ {
            compatible = "zmk,behavior-mod-morph";
            label = "mod_morph_q_esc";
            bindings = <&kp ESCAPE>, <&kp Q>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        mod_morph_bs_p: mod_morph_bs_p_ {
            compatible = "zmk,behavior-mod-morph";
            label = "mod_morph_bs_p";
            bindings = <&kp BACKSPACE>, <&kp P>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mod_morph_tab_q: mod_morph_tab_q_ {
            compatible = "zmk,behavior-mod-morph";
            label = "mod_morph_tab_q";
            bindings = <&kp TAB>, <&kp Q>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        mod_morph_bracket: mod_morph_bracket_ {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_BRACKET";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        mod_morph_brace: mod_morph_brace_ {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_BRACE";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        mod_morph_del_percent: mod_morph_del_percent_ {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_DEL_PERCENT";
            bindings = <&kp DELETE>, <&kp PERCENT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hold_tap_kp_kp: hold_tap_kp_kp_ {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <90>;
            quick-tap-ms = <90>;
        };

        hold_tap_lt_kp: hold_tap_lt_kp_ {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LT_KP";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;
            quick-tap-ms = <100>;
        };

        toggle_mode_off: toggle_mode_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOGGLE_MODE_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hold_tap_lt5: hold_tap_lt5 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LT5";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;
            quick-tap-ms = <100>;
        };

        mod_morph_l3_percent: mod_morph_l3_percent {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_L3_PERCENT";
            bindings = <&kp DELETE>, <&kp PERCENT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        layer2 {
            bindings = <&mo 2>;
            key-positions = <34 23>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <11 12>;
            layers = <1>;
        };

        Window {
            bindings = <&kp RIGHT_WIN>;
            key-positions = <17 16>;
        };

        Control {
            bindings = <&kp RCTRL>;
            key-positions = <18 17>;
        };

        p {
            bindings = <&kp P>;
            key-positions = <8 9>;
            timeout-ms = <125>;
        };

        q {
            bindings = <&kp Q>;
            key-positions = <0 1>;
            timeout-ms = <125>;
        };

        toggle_off {
            bindings = <&toggle_mode_off 1>;
            key-positions = <12 13>;
            timeout-ms = <90>;
        };

        layer5 {
            bindings = <&mo 5>;
            key-positions = <34 13>;
            timeout-ms = <75>;
        };

        Right_Click2 {
            bindings = <&mkp MB2>;
            key-positions = <30 31>;
        };

        us_kana {
            bindings = <&kp LA(GRAVE)>;
            key-positions = <11 18>;
            layers = <0>;
        };

        layer5_2 {
            bindings = <&mo 5>;
            key-positions = <34 12>;
            timeout-ms = <75>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&mod_morph_q_esc              &kp W         &kp E           &kp R           &kp T                                      &kp Y            &kp U           &kp I            &kp O      &mod_morph_bs_p
&hold_tap_kp_kp LCTRL A       &kp S         &kp D           &kp F           &kp G                                      &kp H            &kp J           &kp K            &kp L      &lt 3 ENTER
&hold_tap_kp_kp LEFT_SHIFT Z  &kp X         &kp C           &kp V           &kp B                                      &kp N            &kp M           &kp COMMA        &kp DOT    &hold_tap_kp_kp RIGHT_SHIFT SLASH
&mkp MB1                      &kp LEFT_ALT  &kp LEFT_GUI    &msc SCRL_UP    &lt 3 SPACE      &lt 2 TAB    &lt 2 ENTER  &lt 3 BACKSPACE  &msc SCRL_UP    &lt 4 MINUS      &kp EQUAL  &kp SEMI
                                            &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                            &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
&trans    &trans  &trans  &trans    &trans                    &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &mkp MB1  &trans                    &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans    &trans                    &trans  &trans  &trans  &trans  &trans
&mkp MB2  &trans  &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                  &trans  &trans    &trans                    &trans  &trans  &trans
            >;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
&kp ESCAPE      &trans                  &trans                  &trans                   &trans                               &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSPACE
&kp HOME        &kp LG(LC(LEFT_ARROW))  &kp LG(LS(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &kp END                              &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ENTER
&kp LEFT_SHIFT  &kp LEFT_BRACKET        &kp LEFT_BRACE          &kp RIGHT_BRACE          &kp RIGHT_BRACKET                    &kp KP_PLUS      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
&trans          &trans                  &trans                  &kp UP                   &trans             &trans    &trans  &kp KP_MINUS     &kp UP        &kp NUMBER_0  &kp PERIOD    &kp COLON
                                        &kp LEFT                &kp DOWN                 &kp RIGHT                            &kp LEFT         &kp DOWN      &kp RIGHT
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Mark Layer";
            bindings = <
&kp QUESTION    &kp DOUBLE_QUOTES  &kp EQUAL   &kp ASTRK  &kp CARET                        &trans         &kp UNDER       &kp UP_ARROW     &mod_morph_lp_rp       &mod_morph_l3_percent
&kp AT_SIGN     &kp SLASH          &kp DOLLAR  &kp SQT    &kp GRAVE                        &kp HASH       &kp LEFT        &kp RIGHT_ARROW  &kp RIGHT_PARENTHESIS  &kp ENTER
&kp LEFT_SHIFT  &kp EXCL           &kp COLON   &kp F10    &kp BACKSLASH                    &kp AMPERSAND  &kp DOWN_ARROW  &trans           &kp PAGE_UP            &kp RIGHT_SHIFT
&trans          &trans             &trans      &trans     &trans         &trans    &trans  &kp LA(GRAVE)  &trans          &mkp MB4         &kp PAGE_DOWN          &mkp MB5
                                   &trans      &trans     &trans                           &trans         &trans          &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &none           &none   &none   &none  &none
&none           &none         &none         &none         &none                                     &none           &none   &none   &none  &none
&bt BT_CLR      &none         &none         &none         &none                                     &none           &none   &none   &none  &none
&bt BT_CLR_ALL  &none         &none         &none         &none         &bootloader    &bootloader  &studio_unlock  &none   &none   &none  &none
                              &trans        &trans        &trans                                    &trans          &trans  &trans
            >;
        };

        layer_5 {
            #

            status = "reserved";
            display-name = "Function Layer";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                     &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10                    &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans                     &kp F11  &kp F12  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans   &trans   &trans  &trans  &trans
                &trans  &trans  &trans                     &trans   &trans   &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };
    };
};

#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        td_tab_q: td_tab_q {
            compatible = "zmk,behavior-tap-dance";
            label = "td_tab_q";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp Q>;

            tapping-term-ms = <200>;
        };

        td_semicolon_colon: td_semicolon_colon {
            compatible = "zmk,behavior-tap-dance";
            label = "td_colon_behavior";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp COLON>;

            tapping-term-ms = <250>;
        };

        mod_morph_lp_rp: mod_morph_lp_rp_ {
            compatible = "zmk,behavior-mod-morph";
            label = "mod_morph_lp_rp";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_morph_q_esc: mod_morph_q_esc_ {
            compatible = "zmk,behavior-mod-morph";
            label = "mod_morph_q_esc";
            bindings = <&kp ESCAPE>, <&kp Q>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        mod_morph_bs_p: mod_morph_bs_p_ {
            compatible = "zmk,behavior-mod-morph";
            label = "mod_morph_bs_p";
            bindings = <&kp BACKSPACE>, <&kp P>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mod_morph_tab_q: mod_morph_tab_q_ {
            compatible = "zmk,behavior-mod-morph";
            label = "mod_morph_tab_q";
            bindings = <&kp TAB>, <&kp Q>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        mod_morph_bracket: mod_morph_bracket_ {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_BRACKET";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        mod_morph_brace: mod_morph_brace_ {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_BRACE";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        mod_morph_del_percent: mod_morph_del_percent_ {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_DEL_PERCENT";
            bindings = <&kp DELETE>, <&kp PERCENT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hold_tap_kp_kp: hold_tap_kp_kp_ {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <90>;
            quick-tap-ms = <90>;
        };

        hold_tap_lt_kp: hold_tap_lt_kp_ {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LT_KP";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;
            quick-tap-ms = <100>;
        };

        toggle_mode_off: toggle_mode_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOGGLE_MODE_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hold_tap_lt5: hold_tap_lt5 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LT5";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;
            quick-tap-ms = <100>;
        };

        mod_morph_l3_percent: mod_morph_l3_percent {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_L3_PERCENT";
            bindings = <&kp DELETE>, <&kp PERCENT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        layer2 {
            bindings = <&mo 2>;
            key-positions = <34 23>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <11 12>;
            layers = <1>;
        };

        Window {
            bindings = <&kp RIGHT_WIN>;
            key-positions = <17 16>;
        };

        Control {
            bindings = <&kp RCTRL>;
            key-positions = <18 17>;
        };

        p {
            bindings = <&kp P>;
            key-positions = <8 9>;
            timeout-ms = <125>;
        };

        q {
            bindings = <&kp Q>;
            key-positions = <0 1>;
            timeout-ms = <125>;
        };

        toggle_off {
            bindings = <&toggle_mode_off 1>;
            key-positions = <12 13>;
            timeout-ms = <90>;
        };

        layer5 {
            bindings = <&mo 5>;
            key-positions = <34 13>;
            timeout-ms = <75>;
        };

        Right_Click2 {
            bindings = <&mkp MB2>;
            key-positions = <30 31>;
        };

        us_kana {
            bindings = <&kp LA(GRAVE)>;
            key-positions = <11 18>;
            layers = <0>;
        };

        layer5_2 {
            bindings = <&mo 5>;
            key-positions = <34 12>;
            timeout-ms = <75>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&mod_morph_q_esc              &kp W         &kp E           &kp R           &kp T                                      &kp Y            &kp U           &kp I            &kp O      &mod_morph_bs_p
&hold_tap_kp_kp LCTRL A       &kp S         &kp D           &kp F           &kp G                                      &kp H            &kp J           &kp K            &kp L      &lt 3 ENTER
&hold_tap_kp_kp LEFT_SHIFT Z  &kp X         &kp C           &kp V           &kp B                                      &kp N            &kp M           &kp COMMA        &kp DOT    &hold_tap_kp_kp RIGHT_SHIFT SLASH
&mkp MB1                      &kp LEFT_ALT  &kp LEFT_GUI    &msc SCRL_UP    &lt 3 SPACE      &lt 2 TAB    &lt 2 ENTER  &lt 3 BACKSPACE  &msc SCRL_UP    &lt 4 MINUS      &kp EQUAL  &kp SEMI
                                            &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                            &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
&trans    &trans  &trans  &trans    &trans                    &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &mkp MB1  &trans                    &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans    &trans                    &trans  &trans  &trans  &trans  &trans
&mkp MB2  &trans  &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                  &trans  &trans    &trans                    &trans  &trans  &trans
            >;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
&kp ESCAPE      &trans                  &trans                  &trans                   &trans                               &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSPACE
&kp HOME        &kp LG(LC(LEFT_ARROW))  &kp LG(LS(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &kp END                              &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ENTER
&kp LEFT_SHIFT  &kp LEFT_BRACKET        &kp LEFT_BRACE          &kp RIGHT_BRACE          &kp RIGHT_BRACKET                    &kp KP_PLUS      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
&trans          &trans                  &trans                  &kp UP                   &trans             &trans    &trans  &kp KP_MINUS     &kp UP        &kp NUMBER_0  &kp PERIOD    &kp COLON
                                        &kp LEFT                &kp DOWN                 &kp RIGHT                            &kp LEFT         &kp DOWN      &kp RIGHT
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Mark Layer";
            bindings = <
&kp QUESTION    &kp DOUBLE_QUOTES  &kp EQUAL   &kp ASTRK  &kp CARET                        &trans         &kp UNDER       &kp UP_ARROW     &mod_morph_lp_rp       &mod_morph_l3_percent
&kp AT_SIGN     &kp SLASH          &kp DOLLAR  &kp SQT    &kp GRAVE                        &kp HASH       &kp LEFT        &kp RIGHT_ARROW  &kp RIGHT_PARENTHESIS  &kp ENTER
&kp LEFT_SHIFT  &kp EXCL           &kp COLON   &kp F10    &kp BACKSLASH                    &kp AMPERSAND  &kp DOWN_ARROW  &trans           &kp PAGE_UP            &kp RIGHT_SHIFT
&trans          &trans             &trans      &trans     &trans         &trans    &trans  &kp LA(GRAVE)  &trans          &mkp MB4         &kp PAGE_DOWN          &mkp MB5
                                   &trans      &trans     &trans                           &trans         &trans          &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &none           &none   &none   &none  &none
&none           &none         &none         &none         &none                                     &none           &none   &none   &none  &none
&bt BT_CLR      &none         &none         &none         &none                                     &none           &none   &none   &none  &none
&bt BT_CLR_ALL  &none         &none         &none         &none         &bootloader    &bootloader  &studio_unlock  &none   &none   &none  &none
                              &trans        &trans        &trans                                    &trans          &trans  &trans
            >;
        };

        layer_5 {
            #

            status = "reserved";
            display-name = "Function Layer";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                     &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10                    &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans                     &kp F11  &kp F12  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans   &trans   &trans  &trans  &trans
                &trans  &trans  &trans                     &trans   &trans   &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
